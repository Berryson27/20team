{
  "functions": {
    "source": "functions",
    "codebase": "hanq",
    "ignore": ["node_modules", ".git", "*.local", "**/.*"],
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/verify", "function": "verify" },
      { "source": "/api/reports", "function": "reports" },
      { "source": "/api/map/summary", "function": "mapSummary" },
      { "source": "/api/issuers/qr", "function": "issuerQr" },
      { "source": "/api/issuers/me/dashboard", "function": "issuerDashboard" },
      { "source": "/api/track", "function": "track" },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      { "source": "**", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.@(js|css|woff2|woff|png|svg|ico|webp|jpg|jpeg|gif)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
    ]
  },
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "hosting": { "port": 5055 },
    "ui": { "enabled": true },
    "singleProjectMode": true
  }
}
